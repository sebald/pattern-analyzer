{
  "name": "pattern-analyzer-monorepo",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@8.15.4",
  "engines": {
    "node": ">=22.11",
    "pnpm": ">=8"
  },
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "format": "prettier . --write",
    "clean": "turbo clean",
    "update:points": "pnpm --filter pattern-analyzer.app update:yasb && pnpm --filter pattern-analyzer.app update:xwing",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "turbo build --filter @pattern-analyzer/xws && changeset publish"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^0.7.0",
    "@changesets/cli": "^2.31.1",
    "prettier": "3.9.10",
    "turbo": "^2.11.10"
  },
  "pnpm": {
    "overrides": {
      "postcss-selector-parser@6": "^7.1.6"
    },
    "peerDependencyRules": {
      "allowedVersions": {
        "eslint-plugin-react>eslint": "10",
        "eslint-plugin-import>eslint": "10",
        "eslint-plugin-jsx-a11y>eslint": "10"
      }
    }
  }
}
